# 默认使用发布镜像；自行构建后可改为 keyfolio:local。
IMAGE=wxdadadada/account-vault:0.1.0
# 浏览器实际访问的地址。远程访问请使用 HTTPS。
APP_ORIGIN=http://localhost:4318
# Docker 映射到宿主机的端口。
PORT=4318
# 远程 HTTPS 部署必填：服务实际看到的直连代理 IP/CIDR，英文逗号分隔。
# 本地 Node + 同机代理可用 127.0.0.1,::1；Docker 需填实际桥接网关/代理地址。
# 留空仅用于默认本机直连，禁止填写 true、* 或全网 CIDR。
TRUSTED_PROXIES=
# 自定义兼容模型服务时，将域名加入此列表；仅允许 HTTPS 公网地址。
AI_ALLOWED_HOSTS=api.deepseek.com,api.openai.com,api.moonshot.cn,api.moonshot.ai,dashscope.aliyuncs.com,openrouter.ai
