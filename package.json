  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm clean && tsc -b && vite build && tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "tsx --test tests/*.test.ts",
    "test:watch": "tsx --test --watch tests/*.test.ts",
    "test:browser": "pnpm build && playwright test",
    "dev:api": "tsx watch server/index.ts",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5188 --strictPort",
    "check": "pnpm format:check && pnpm lint && pnpm test && pnpm build",
    "clean": "node scripts/clean.mjs",
    "test:docker": "tsx scripts/docker-smoke.ts"
  },
